{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Emit declarations only — never `.js`. `outDir` is `dist`, the SAME
    // directory electron-vite writes the bundled main+preload to. If `tsc -b`
    // (pnpm typecheck) transpiled `src/preload/index.ts` → `dist/preload/index.js`
    // it would clobber the electron-vite bundle with a raw
    // `require("@ft5/ipc-contracts")` (breaking the sandbox + tripping
    // `scripts/preload-bundle.test.ts`). apps/desktop is a leaf — nothing
    // consumes its emit; the runtime build is electron-vite — so tsc type-checks
    // and emits `.d.ts` only, leaving the `dist/**/*.js` bundles to electron-vite.
    "emitDeclarationOnly": true,
    "types": ["node"],
    // The compiled runtime for main+preload is CJS (see
    // `electron.vite.config.ts`'s `formats: ["cjs"]`), and `package.json` no
    // longer declares `"type": "module"` (Section 8). Under NodeNext that
    // makes TS treat sources as CJS, which conflicts with the ESM `import`
    // syntax we use when `verbatimModuleSyntax: true` is inherited from the
    // base config. Vite/Rollup transforms the `import`s to `require`s at
    // bundle time, so the source form is fine — we just need TS to stop
    // policing it here.
    "verbatimModuleSyntax": false
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "dist", "node_modules"],
  "references": [
    { "path": "../../packages/ipc-contracts" },
    { "path": "../../packages/fs-datasource-engine" }
  ]
}
